"use client";
import { createContext, useCallback, useContext, useEffect, useState, type ReactNode } from "react";

export type RenderMode = "terminal" | "code" | "diff" | "chain" | "hexdump" | "yara" | "runbook" | "pcap";

export interface ScriptSettings {
  renderMode: RenderMode; fontFamily: string; fontSize: number; fontWeight: number;
  letterSpacing: number; lineHeight: number;
  textColor: string; bgColor: string; transparent: boolean;
  padding: number; borderRadius: number;
  textAlign: "left" | "center" | "right"; wrap: boolean; maxWidth: number;
  exportPreset: string;
  strokeEnabled: boolean; strokeWidth: number; strokeColor: string;
  theme: string; soundOn: boolean;
  animationFrames: number; animationHoldMs: number; animationScale: number;
}

const DEFAULTS: ScriptSettings = {
  renderMode: "terminal", fontFamily: "JetBrains Mono", fontSize: 14, fontWeight: 500,
  letterSpacing: 0, lineHeight: 1.55, textColor: "#00ff41", bgColor: "#000000",
  transparent: false, padding: 32, borderRadius: 12, textAlign: "left",
  wrap: true, maxWidth: 720, exportPreset: "reel4k",
  strokeEnabled: false, strokeWidth: 0, strokeColor: "#000000",
  theme: "terminal-green", soundOn: true,
  animationFrames: 18, animationHoldMs: 220, animationScale: 1,
};

const Ctx = createContext<{
  s: ScriptSettings;
  set: <K extends keyof ScriptSettings>(k: K, v: ScriptSettings[K]) => void;
  reset: () => void;
} | null>(null);

const LS_KEY = "hak.studio";

export function ScriptSettingsProvider({ children }: { children: ReactNode }) {
  const [s, setS] = useState<ScriptSettings>(DEFAULTS);
  useEffect(() => {
    try { const r = localStorage.getItem(LS_KEY); if (r) setS({ ...DEFAULTS, ...JSON.parse(r) }); } catch {}
  }, []);
  useEffect(() => { try { localStorage.setItem(LS_KEY, JSON.stringify(s)); } catch {} }, [s]);
  const set = useCallback(<K extends keyof ScriptSettings>(k: K, v: ScriptSettings[K]) => setS((p) => ({ ...p, [k]: v })), []);
  const reset = useCallback(() => setS(DEFAULTS), []);
  return <Ctx.Provider value={{ s, set, reset }}>{children}</Ctx.Provider>;
}

export function useScriptSettings() {
  const c = useContext(Ctx); if (!c) throw new Error("useScriptSettings outside provider"); return c;
}