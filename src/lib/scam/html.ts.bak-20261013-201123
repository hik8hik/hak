import type { ScamFinding, EvidenceRow } from "./types";
import {
  CERT_BADGE_PATTERNS,
  INSTALL_APP_PATTERNS,
  KENYAN_BRAND_TOKENS,
} from "./threats";

const UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36";
const MAX_BYTES = 2_000_000;
const TIMEOUT_MS = 10_000;

export interface HtmlAnalysis {
  ok: boolean;
  status: number;
  contentType: string;
  sizeBytes: number;
  finalUrl: string;
  title: string;
  metaDescription: string;
  faviconUrl: string | null;
  scriptSrcs: string[];
  stylesheetSrcs: string[];
  imageSrcs: string[];
  externalOrigins: { origin: string; isThirdParty: boolean }[];
  formActions: { action: string; method: string; external: boolean }[];
  emails: string[];
  socialHandles: string[];
  brandMentions: string[];
  kenyanBrandTokens: string[];
  installAppHits: string[];
  certBadges: string[];
  hasVisibleLoginForm: boolean;
  rawHtml: string;
}

interface FetchResult {
  ok: boolean;
  status: number;
  contentType: string;
  body: string;
  sizeBytes: number;
  finalUrl: string;
  error?: string;
}

async function fetchHtml(url: string): Promise<FetchResult> {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), TIMEOUT_MS);
  try {
    const r = await fetch(url, {
      method: "GET",
      redirect: "follow",
      signal: ctrl.signal,
      cache: "no-store",
      headers: {
        "User-Agent": UA,
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.9",
      },
    });
    const contentType = r.headers.get("content-type") || "";
    const text = await r.text();
    const capped = text.length > MAX_BYTES ? text.slice(0, MAX_BYTES) : text;
    return {
      ok: r.ok,
      status: r.status,
      contentType,
      body: capped,
      sizeBytes: text.length,
      finalUrl: r.url || url,
    };
  } catch (e) {
    return {
      ok: false,
      status: 0,
      contentType: "",
      body: "",
      sizeBytes: 0,
      finalUrl: url,
      error: String(e),
    };
  } finally {
    clearTimeout(t);
  }
}

function decodeEntities(s: string): string {
  return s
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&nbsp;/g, " ")
    .replace(/&#(\d+);/g, (_m, n) => String.fromCharCode(Number(n)))
    .replace(/&#x([0-9a-f]+);/gi, (_m, n) => String.fromCharCode(parseInt(n, 16)));
}

function abs(url: string, base: string): string | null {
  try { return new URL(url, base).toString(); } catch { return null; }
}

function origin(url: string): string | null {
  try { return new URL(url).origin; } catch { return null; }
}

function extractMeta(html: string): { title: string; description: string } {
  const title = (html.match(/<title[^>]*>([\s\S]*?)<\/title>/i)?.[1] || "").trim();
  const desc = html.match(/<meta[^>]+name=["']description["'][^>]+content=["']([^"']+)["']/i)?.[1]
    || html.match(/<meta[^>]+property=["']og:description["'][^>]+content=["']([^"']+)["']/i)?.[1]
    || "";
  return { title: decodeEntities(title), description: decodeEntities(desc) };
}

function extractFavicon(html: string, base: string): string | null {
  const m = html.match(/<link[^>]+rel=["'](?:icon|shortcut icon|apple-touch-icon)["'][^>]+href=["']([^"']+)["']/i);
  if (!m) return null;
  return abs(m[1], base);
}

function extractSrcs(html: string, base: string, tagName: string): string[] {
  const re = new RegExp("<" + tagName + "[^>]+src=[\"']([^\"']+)[\"']", "gi");
  const out: string[] = [];
  let m: RegExpExecArray | null;
  while ((m = re.exec(html)) !== null) {
    const u = abs(m[1], base);
    if (u) out.push(u);
  }
  return out;
}

function extractHrefs(html: string, base: string, relMatch: RegExp): string[] {
  const out: string[] = [];
  const tagRe = /<link[^>]+>/gi;
  let m: RegExpExecArray | null;
  while ((m = tagRe.exec(html)) !== null) {
    const tag = m[0];
    if (!relMatch.test(tag)) continue;
    const href = tag.match(/href=["']([^"']+)["']/i)?.[1];
    if (!href) continue;
    const u = abs(href, base);
    if (u) out.push(u);
  }
  return out;
}

function extractForms(html: string, base: string, regDomain: string) {
  const out: { action: string; method: string; external: boolean }[] = [];
  const tagRe = /<form[^>]*>/gi;
  let m: RegExpExecArray | null;
  while ((m = tagRe.exec(html)) !== null) {
    const tag = m[0];
    const actionRaw = tag.match(/action=["']([^"']*)["']/i)?.[1] || "";
    const method = (tag.match(/method=["']([^"']+)["']/i)?.[1] || "get").toLowerCase();
    const actionUrl = actionRaw ? abs(actionRaw, base) : base;
    if (!actionUrl) continue;
    let external = false;
    try {
      const ah = new URL(actionUrl).hostname;
      const ahReg = ah.split(".").slice(-2).join(".");
      external = ahReg !== regDomain;
    } catch { /* ignore */ }
    out.push({ action: actionUrl, method, external });
  }
  return out;
}

function extractEmails(html: string): string[] {
  const re = /[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi;
  const set = new Set<string>();
  let m: RegExpExecArray | null;
  while ((m = re.exec(html)) !== null) set.add(m[0].toLowerCase());
  return Array.from(set);
}

function extractSocialHandles(html: string): string[] {
  const set = new Set<string>();
  const re = /@([A-Za-z][A-Za-z0-9_]{2,30})/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(html)) !== null) set.add("@" + m[1]);
  return Array.from(set);
}

function findPatternHits(html: string, patterns: RegExp[]): string[] {
  const hits: string[] = [];
  for (const re of patterns) {
    const m = html.match(re);
    if (m && m.length) hits.push(m[0]);
  }
  return hits;
}

export async function analyzeHtml(
  url: string,
  registrableDomain: string,
  brands: string[],
): Promise<{ finding: ScamFinding; analysis: HtmlAnalysis }> {
  const fetched = await fetchHtml(url);
  const empty: HtmlAnalysis = {
    ok: false, status: fetched.status, contentType: fetched.contentType,
    sizeBytes: fetched.sizeBytes, finalUrl: fetched.finalUrl,
    title: "", metaDescription: "", faviconUrl: null,
    scriptSrcs: [], stylesheetSrcs: [], imageSrcs: [],
    externalOrigins: [], formActions: [], emails: [], socialHandles: [],
    brandMentions: [], kenyanBrandTokens: [], installAppHits: [],
    certBadges: [], hasVisibleLoginForm: false, rawHtml: "",
  };
  if (!fetched.ok || !fetched.body) {
    return {
      analysis: empty,
      finding: {
        id: "html", kind: "html",
        title: "Page content analysis",
        summary: fetched.error
          ? "Could not fetch the page: " + fetched.error
          : "Page did not respond with a 2xx status (HTTP " + fetched.status + ").",
        severity: "info",
        evidence: [{ label: "URL", value: url }],
      },
    };
  }

  const html = fetched.body;
  const base = fetched.finalUrl;
  const meta = extractMeta(html);
  const favicon = extractFavicon(html, base);
  const scripts = extractSrcs(html, base, "script");
  const styles = extractHrefs(html, base, /rel=["'][^"']*stylesheet/i);
  const images = extractSrcs(html, base, "img");

  // External origins
  const origins = new Map<string, boolean>();
  for (const u of [...scripts, ...styles, ...images]) {
    const o = origin(u);
    if (!o) continue;
    let third = true;
    try { third = new URL(o).hostname.split(".").slice(-2).join(".") !== registrableDomain; } catch {}
    origins.set(o, third);
  }
  const externalOrigins = Array.from(origins.entries()).map(([origin, isThirdParty]) => ({ origin, isThirdParty }));

  const forms = extractForms(html, base, registrableDomain);
  const emails = extractEmails(html);
  const handles = extractSocialHandles(html);

  // Brand mentions: search body text (strip tags for cleanliness)
  const bodyText = decodeEntities(html.replace(/<script[\s\S]*?<\/script>/gi, " ").replace(/<style[\s\S]*?<\/style>/gi, " ").replace(/<[^>]+>/g, " "));
  const bodyLower = bodyText.toLowerCase();
  const brandMentions: string[] = [];
  for (const b of brands) {
    const re = new RegExp("\\b" + b + "\\b", "i");
    if (re.test(bodyLower)) brandMentions.push(b);
  }
  const kenyanHits = KENYAN_BRAND_TOKENS.filter((t) => bodyLower.includes(t));

  const installAppHits = findPatternHits(html, INSTALL_APP_PATTERNS);
  const certBadges = findPatternHits(html, CERT_BADGE_PATTERNS);
  const hasVisibleLoginForm = forms.length > 0 || /<input[^>]+type=["']password["']/i.test(html);

  const analysis: HtmlAnalysis = {
    ok: true, status: fetched.status, contentType: fetched.contentType,
    sizeBytes: fetched.sizeBytes, finalUrl: base,
    title: meta.title, metaDescription: meta.description, faviconUrl: favicon,
    scriptSrcs: scripts, stylesheetSrcs: styles, imageSrcs: images,
    externalOrigins, formActions: forms, emails, socialHandles: handles,
    brandMentions, kenyanBrandTokens: kenyanHits,
    installAppHits, certBadges, hasVisibleLoginForm, rawHtml: html,
  };

  // Build the finding
  const evidence: EvidenceRow[] = [];
  const flags: string[] = [];

  if (meta.title) evidence.push({ label: "Title", value: meta.title.slice(0, 180) });
  if (meta.description) evidence.push({ label: "Description", value: meta.description.slice(0, 220) });
  if (fetched.finalUrl !== url) {
    evidence.push({ label: "Redirected to", value: fetched.finalUrl, bad: true });
    flags.push("redirect");
  }

  const thirdParty = externalOrigins.filter((o) => o.isThirdParty);
  if (thirdParty.length) {
    evidence.push({
      label: "Third-party origins",
      value: thirdParty.map((o) => o.origin).slice(0, 6).join(", ") + (thirdParty.length > 6 ? " +" + (thirdParty.length - 6) + " more" : ""),
      bad: thirdParty.length > 5,
    });
    if (thirdParty.length > 8) flags.push("many-third-parties");
  }

  const externalForms = forms.filter((f) => f.external);
  if (externalForms.length) {
    evidence.push({
      label: "Forms POST to external domain",
      value: externalForms.map((f) => f.action).slice(0, 3).join(", "),
      bad: true,
    });
    flags.push("external-form");
  }

  if (emails.length) {
    const externalEmails = emails.filter((e) => {
      const reg = e.split("@")[1]?.split(".").slice(-2).join(".");
      return reg && reg !== registrableDomain;
    });
    if (externalEmails.length) {
      evidence.push({ label: "Contact email on other domain", value: externalEmails.slice(0, 4).join(", "), bad: true });
      flags.push("external-email");
    } else {
      evidence.push({ label: "Contact email(s)", value: emails.slice(0, 4).join(", ") });
    }
  }

  if (brandMentions.length) {
    evidence.push({ label: "Brands mentioned", value: brandMentions.slice(0, 8).join(", ") });
  }
  if (kenyanHits.length) {
    evidence.push({ label: "Kenyan brand tokens", value: kenyanHits.join(", ") });
    flags.push("kenyan-tokens");
  }
  if (installAppHits.length) {
    evidence.push({ label: "Install-app prompts", value: installAppHits.join(" | "), bad: true });
    flags.push("install-app");
  }
  if (certBadges.length) {
    evidence.push({ label: "Certification badges", value: certBadges.join(" | ") });
    flags.push("cert-badges");
  }

  let severity: ScamFinding["severity"] = "info";
  if (flags.includes("external-form") || flags.includes("install-app")) severity = "critical";
  else if (flags.includes("external-email") || flags.includes("redirect")) severity = "high";
  else if (flags.length) severity = "medium";

  const summary = flags.length
    ? flags.length + " content-level indicator(s) detected."
    : "Page content looks structurally ordinary.";

  return {
    analysis,
    finding: {
      id: "html", kind: "html",
      title: "Page content analysis",
      summary, severity, evidence,
      references: [fetched.finalUrl],
    },
  };
}
