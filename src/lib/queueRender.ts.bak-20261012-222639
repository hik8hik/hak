import type { ThreatItem } from "./types";
import { severityVar, tacticVar } from "./colors";

export function buildQueueHtml(it: ThreatItem): string {
  const sev = severityVar(it.severity);
  const tactics = (it.tactics || []).map(
    (t) => `<span style="display:inline-block;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;margin:2px;background:#dfe4ec;color:${tacticVar(t)}">${t}</span>`
  ).join("");
  const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c] as string));
  return `<div style="padding:60px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#1a2233;background:#e8ecf3;height:100%;box-sizing:border-box">
    <div style="font-family:JetBrains Mono,monospace;font-size:14px;color:#5a6478">${esc(it.id)}</div>
    <div style="display:inline-block;padding:4px 10px;border-radius:999px;background:${sev};color:#fff;font-size:12px;font-weight:600;margin:8px 0">${it.severity || "none"}</div>
    <h1 style="font-size:44px;line-height:1.15;margin:8px 0 18px">${esc(it.title)}</h1>
    <p style="font-size:20px;line-height:1.5;color:#5a6478">${esc(it.summary.slice(0, 420))}</p>
    <div style="margin-top:20px">${tactics}</div>
    <div style="position:absolute;bottom:40px;left:60px;font-size:13px;color:#8892a6">hak · cyber reader</div>
  </div>`;
}
