"use client";
import { useMemo } from "react";
import {
  PieChart, Pie, Cell,
  RadarChart, PolarGrid, PolarAngleAxis, PolarRadiusAxis, Radar,
  BarChart, Bar, XAxis, YAxis, LabelList,
  ResponsiveContainer,
} from "recharts"
import type { ChartSpec, ScamSeverity } from "@/lib/scam/types"

const SEV_COLOR: Record<ScamSeverity, string> = {
  critical: "#DD0008",
  high: "#FF7E1E",
  medium: "#FFC107",
  low: "#4ECB4A",
  info: "#8892a6",
}

/** Fixed-height wrapper. ResponsiveContainer measures zero
 *  when the parent has no explicit height, which can leave the
 *  chart state empty and crash on the first paint. */
function Box({ height, children }: { height: number; children: React.ReactNode }) {
  return (
    <div style={{ width: "100%", height, minHeight: height }}>
      {children}
    </div>
  )
}

export default function ScamChartRenderer({ spec }: { spec: ChartSpec }) {
  switch (spec.type) {
    case "gauge":            return <Gauge spec={spec} />
    case "radar":            return <Radar spec={spec} />
    case "domainAge":        return <DomainAge spec={spec} />
    case "reputation":       return <Reputation spec={spec} />
    case "dnsChecklist":     return <DnsChecklist spec={spec} />
    case "tlsValidity":      return <TlsValidity spec={spec} />
    case "evidenceWeight":   return <EvidenceWeight spec={spec} />
    default:                 return null
  }
}

// ─── Gauge — PieChart semicircle ────────────────────────────────────

function Gauge({ spec }: { spec: Extract<ChartSpec, { type: "gauge" }> }) {
  const score = Math.max(0, Math.min(100, spec.score))
  const color = SEV_COLOR[spec.severity]
  const data = useMemo(() => ([
    { name: "score", value: score, fill: color },
    { name: "rest",  value: 100 - score, fill: "rgba(255,255,255,0.06)" },
  ]), [score, color])

  return (
    <div style={{ position: "relative", width: "100%", height: 240, minHeight: 240 }}>
      <ResponsiveContainer width="100%" height="100%">
        <PieChart>
          <Pie
            data={data}
            cx="50%"
            cy="90%"
            startAngle={180}
            endAngle={0}
            innerRadius="65%"
            outerRadius="100%"
            dataKey="value"
            stroke="none"
            isAnimationActive={false}
          >
            {data.map((d, i) => <Cell key={i} fill={d.fill} />)}
          </Pie>
        </PieChart>
      </ResponsiveContainer>
      <div
        style={{
          position: "absolute",
          left: 0, right: 0, top: "55%",
          textAlign: "center", pointerEvents: "none",
        }}
      >
        <div
          style={{
            fontSize: 44, fontWeight: 900, lineHeight: 1,
            color: color, letterSpacing: "-0.03em",
          }}
        >
          {score}
        </div>
        <div
          style={{
            fontSize: 11, letterSpacing: "0.15em",
            color: "var(--text-dim)", textTransform: "uppercase",
            marginTop: 4,
          }}
        >
          Risk score
        </div>
      </div>
    </div>
  )
}

// ─── Radar — PolarAngleAxis + PolarRadiusAxis both wired ────────────

function Radar({ spec }: { spec: Extract<ChartSpec, { type: "radar" }> }) {
  const data = spec.axes.map((a) => ({
    axis: a.label,
    value: Math.max(0, Math.min(100, a.value)),
  }))
  if (data.length < 3) {
    return <div style={{ fontSize: 13, color: "var(--text-dim)" }}>
      Not enough axes to draw a radar chart.
    </div>
  }
  return (
    <Box height={320}>
      <ResponsiveContainer width="100%" height="100%">
        <RadarChart data={data} cx="50%" cy="50%" outerRadius="72%">
          <PolarGrid stroke="rgba(255,255,255,0.10)" />
          <PolarAngleAxis
            dataKey="axis"
            angleAxisId={0}
            tick={{ fill: "#8b97b0", fontSize: 12 }}
          />
          <PolarRadiusAxis
            angle={90}
            domain={[0, 100]}
            radiusAxisId={0}
            tick={false}
            axisLine={false}
          />
          <Radar
            name="severity"
            dataKey="value"
            angleAxisId={0}
            radiusAxisId={0}
            stroke="#7BA5FF"
            fill="#7BA5FF"
            fillOpacity={0.25}
            isAnimationActive={false}
          />
        </RadarChart>
      </ResponsiveContainer>
    </Box>
  )
}

// ─── Domain age ─────────────────────────────────────────────────────

const AGE_BUCKETS = [
  { label: "<7d",     max: 7 },
  { label: "7-30d",   max: 30 },
  { label: "1-6mo",   max: 180 },
  { label: "6-12mo",  max: 365 },
  { label: "1yr+",    max: Number.POSITIVE_INFINITY },
]

function DomainAge({ spec }: { spec: Extract<ChartSpec, { type: "domainAge" }> }) {
  const age = spec.ageDays
  const data = AGE_BUCKETS.map((b, i) => {
    const prev = i === 0 ? 0 : AGE_BUCKETS[i - 1].max
    const inBucket = age !== null && age >= prev && age < b.max
    const color = inBucket
      ? age! < 14 ? "#DD0008"
        : age! < 30 ? "#FF7E1E"
        : age! < 180 ? "#FFC107"
        : "#4ECB4A"
      : "rgba(255,255,255,0.06)"
    return { name: b.label, value: 100, fill: color }
  })
  const headline =
    age === null ? "Domain age unknown" :
    age < 14    ? age + " days old \u2014 extremely young" :
    age < 30    ? age + " days old" :
    age < 180   ? Math.round(age / 30) + " months old" :
                  (Math.round(age / 365 * 10) / 10) + " years old"

  return (
    <div>
      <div style={{ marginBottom: 8, fontWeight: 700, fontSize: 14 }}>{headline}</div>
      <Box height={140}>
        <ResponsiveContainer width="100%" height="100%">
          <BarChart
            data={data}
            layout="vertical"
            margin={{ top: 4, right: 8, bottom: 4, left: 8 }}
          >
            <XAxis type="number" hide domain={[0, 100]} />
            <YAxis
              type="category"
              dataKey="name"
              tick={{ fill: "#8b97b0", fontSize: 11 }}
              width={60}
            />
            <Bar dataKey="value" radius={[0, 4, 4, 0]} isAnimationActive={false}>
              {data.map((d, i) => <Cell key={i} fill={d.fill} />)}
            </Bar>
          </BarChart>
        </ResponsiveContainer>
      </Box>
    </div>
  )
}

// ─── Reputation ─────────────────────────────────────────────────────

function Reputation({ spec }: { spec: Extract<ChartSpec, { type: "reputation" }> }) {
  const data = [
    { name: "Malicious",  value: spec.malicious,  fill: "#DD0008" },
    { name: "Suspicious", value: spec.suspicious, fill: "#FF7E1E" },
    { name: "Clean",      value: spec.harmless + spec.undetected, fill: "#4ECB4A" },
  ]
  return (
    <div>
      <Box height={200}>
        <ResponsiveContainer width="100%" height="100%">
          <BarChart
            data={data}
            layout="vertical"
            margin={{ top: 6, right: 40, bottom: 6, left: 90 }}
          >
            <XAxis type="number" hide />
            <YAxis
              type="category"
              dataKey="name"
              tick={{ fill: "#8b97b0", fontSize: 13 }}
              width={90}
            />
            <Bar dataKey="value" radius={[0, 6, 6, 0]} isAnimationActive={false}>
              {data.map((d, i) => <Cell key={i} fill={d.fill} />)}
              <LabelList dataKey="value" position="right" fill="#e6ecf5" fontSize={14} fontWeight={700} />
            </Bar>
          </BarChart>
        </ResponsiveContainer>
      </Box>
      <div style={{ textAlign: "center", fontSize: 12, color: "var(--text-dim)", marginTop: 4 }}>
        {spec.total} engines queried
      </div>
    </div>
  )
}

// ─── DNS checklist ──────────────────────────────────────────────────

function DnsChecklist({ spec }: { spec: Extract<ChartSpec, { type: "dnsChecklist" }> }) {
  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
      {spec.items.map((it, i) => {
        const color = it.present ? "#4ECB4A" : "#DD0008"
        const mark = it.present ? "\u2713" : "\u2715"
        return (
          <div key={i} style={{ display: "flex", alignItems: "center", gap: 10, fontSize: 13 }}>
            <span
              style={{
                width: 22, height: 22, borderRadius: "50%",
                display: "inline-flex", alignItems: "center", justifyContent: "center",
                background: color + "22", color, fontWeight: 800, fontSize: 13,
              }}
            >
              {mark}
            </span>
            <span style={{ fontWeight: 500 }}>{it.label}</span>
          </div>
        )
      })}
    </div>
  )
}

// ─── TLS validity ───────────────────────────────────────────────────

function TlsValidity({ spec }: { spec: Extract<ChartSpec, { type: "tlsValidity" }> }) {
  const from = Date.parse(spec.validFrom)
  const to = Date.parse(spec.validTo)
  const now = Date.now()
  if (Number.isNaN(from) || Number.isNaN(to) || to <= from) {
    return <div style={{ fontSize: 13, color: "var(--text-dim)" }}>TLS validity window unavailable</div>
  }
  const pad = (to - from) * 0.10
  const lo = from - pad
  const hi = to + pad
  const pct = (v: number) => ((v - lo) / (hi - lo)) * 100
  const fromPct = pct(from)
  const toPct = pct(to)
  const nowPct = pct(now)
  const daysLeft = Math.round((to - now) / 86400000)
  const expired = daysLeft < 0
  const color = expired ? "#DD0008" : daysLeft < 15 ? "#FF7E1E" : "#4ECB4A"
  return (
    <div>
      <div style={{ fontSize: 14, fontWeight: 700, color, marginBottom: 10 }}>
        {expired
          ? "Expired " + Math.abs(daysLeft) + " days ago"
          : daysLeft + " days until expiry"}
      </div>
      <div style={{ position: "relative", height: 26, background: "rgba(255,255,255,0.04)", borderRadius: 4 }}>
        <div
          style={{
            position: "absolute",
            left: fromPct + "%",
            width: Math.max(0, toPct - fromPct) + "%",
            top: 0, bottom: 0,
            background: color + "66",
            border: "1.5px solid " + color,
            borderRadius: 4,
          }}
        />
        {nowPct >= 0 && nowPct <= 100 && (
          <div
            style={{
              position: "absolute",
              left: nowPct + "%",
              top: -6, bottom: -4,
              width: 2,
              background: "#7BA5FF",
            }}
          />
        )}
      </div>
      <div
        style={{
          display: "flex", justifyContent: "space-between",
          fontSize: 11, color: "var(--text-dim)", marginTop: 6,
        }}
      >
        <span>Issued {spec.validFrom.slice(0, 10)}</span>
        <span>Expires {spec.validTo.slice(0, 10)}</span>
      </div>
    </div>
  )
}

// ─── Evidence weight ────────────────────────────────────────────────

function EvidenceWeight({ spec }: { spec: Extract<ChartSpec, { type: "evidenceWeight" }> }) {
  const data = spec.rows.map((r) => ({
    name: r.title.length > 30 ? r.title.slice(0, 28) + "\u2026" : r.title,
    value: r.weight,
    fill: SEV_COLOR[r.severity],
  }))
  const height = Math.max(140, data.length * 34 + 30)
  return (
    <Box height={height}>
      <ResponsiveContainer width="100%" height="100%">
        <BarChart
          data={data}
          layout="vertical"
          margin={{ top: 6, right: 40, bottom: 6, left: 120 }}
        >
          <XAxis type="number" hide />
          <YAxis
            type="category"
            dataKey="name"
            tick={{ fill: "#8b97b0", fontSize: 12 }}
            width={120}
          />
          <Bar dataKey="value" radius={[0, 4, 4, 0]} isAnimationActive={false}>
            {data.map((d, i) => <Cell key={i} fill={d.fill} />)}
            <LabelList dataKey="value" position="right" fill="#e6ecf5" fontSize={12} fontWeight={700} />
          </Bar>
        </BarChart>
      </ResponsiveContainer>
    </Box>
  )
}